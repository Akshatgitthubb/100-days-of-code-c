#include <stdio.h>
#include <stdint.h>
#include <stdlib.h>

int main(void)
{
    int n;

    if (scanf("%d", &n) != 1 || n < 0) {
        return 1;
    }

    if ((size_t)n > SIZE_MAX / sizeof(int) ||
        (size_t)n > SIZE_MAX / sizeof(long long)) {
        return 1;
    }

    int *nums = malloc((size_t)n * sizeof(int));
    long long *answer = malloc((size_t)n * sizeof(long long));
    if (n > 0 && (nums == NULL || answer == NULL)) {
        free(nums);
        free(answer);
        return 1;
    }

    for (int i = 0; i < n; i++) {
        if (scanf("%d", &nums[i]) != 1) {
            free(nums);
            free(answer);
            return 1;
        }
    }

    int prefix = 1;
    for (int i = 0; i < n; i++) {
        answer[i] = prefix;
        prefix *= nums[i];
    }

    int suffix = 1;
    for (int i = n - 1; i >= 0; i--) {
        answer[i] *= suffix;
        suffix *= nums[i];
    }

    for (int i = 0; i < n; i++) {
        if (i > 0) {
            printf(" ");
        }
        printf("%lld", answer[i]);
    }
    printf("\n");

    free(nums);
    free(answer);
    return 0;
}
